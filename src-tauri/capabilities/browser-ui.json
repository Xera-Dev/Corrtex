    "allow-ext-open",
    "allow-toggle-ext-panel",
    "allow-suggest",
    "allow-suggest-update",
    "allow-suggest-get",
    "allow-suggest-close",
    "allow-set-ai-theme",
    "allow-toggle-ai-skin",
    "allow-set-sidebar-width",
