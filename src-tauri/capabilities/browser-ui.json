{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-ui",
  "description": "Interface du navigateur (barre d'onglets, page d'accueil, en-tête du panneau IA). Pages locales uniquement.",
  "windows": [
    "*"
  ],
  "webviews": [
    "chrome-*",
    "aibar-*",
    "tab-*",
    "panel-*",
    "suggest-*",
    "aires-*",
    "popup-*",
    "preview-*", "shopw-*"
  ],
  "local": true,
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-state",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-move-tab",
    "allow-drag-detach",
    "allow-refresh-google",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-toggle-sidebar",
    "allow-set-ai-provider",
    "allow-media-control",
    "allow-focus-media-tab",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-close",
    "allow-toggle-fullscreen",
    "allow-ai-summarize",
    "allow-ai-page-compare",
    "allow-shop-sites-get",
    "allow-shop-sites-set",
    "allow-shop-sites-reset",
    "allow-ai-compare",
    "allow-set-aibar-extra",
    "allow-set-ai-memory",
    "allow-popup-get",
    "allow-popup-close",
    "allow-popup-fit",
    "allow-tab-menu",
    "allow-group-menu",
    "allow-bookmark-menu",
    "allow-history-complete",
    "allow-translate-page",
    "allow-history-ai",
    "allow-agent-start",
    "allow-agent-open",
    "allow-focus-start",
    "allow-focus-stop",
    "allow-focus-info",
    "allow-focus-sites-set",
    "allow-power-state",
    "allow-set-power-mode",
    "allow-profile-list",
    "allow-profile-create",
    "allow-profile-delete",
    "allow-open-profile-window",
    "allow-app-info",
    "allow-version-seen",
    "allow-set-update-repo",
    "allow-update-check",
    "allow-app-quit",
    "allow-set-app-prefs",
    "allow-shopping-job",
    "allow-shopping-save",
    "allow-shopping-start",
    "allow-shopping-push",
    "allow-agent-history-list",
    "allow-agent-history-delete",
    "allow-agent-history-open",
    "allow-update-status",
    "allow-update-install",
    "allow-keys-get",
    "allow-keys-set",
