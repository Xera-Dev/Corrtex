    "allow-split-open",
    "allow-split-close",
    "allow-read-later-add",
    "allow-read-later-list",
    "allow-read-later-remove",
    "allow-note-get",
    "allow-note-set",
    "allow-popup-show",
    "allow-shop-context",
    "allow-shop-fetch",
    "allow-shop-ask-ai",
    "allow-backup-export",
    "allow-backup-import",
    "allow-tab-preview",
    "allow-preview-close",
    "allow-tab-action",
    "allow-group-action",
    "allow-reopen-closed",
    "allow-set-tab-prefs",
    "allow-history-list",
    "allow-history-delete",
    "allow-history-clear",
    "allow-downloads-list",
    "allow-downloads-clear",
