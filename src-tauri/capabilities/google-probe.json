{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "google-probe",
  "description": "Vue invisible qui lit le profil Google sur google.com, puis se ferme.",
  "windows": [
    "*"
  ],
  "webviews": [
    "gprobe"
  ],
  "remote": {
    "urls": [
      "https://www.google.com/*",
      "https://accounts.google.com/*"
    ]
  },
  "permissions": [
    "allow-google-profile"
  ]
}