{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shop-render",
  "description": "Vues cachées des boutiques (recherche d'achat) : elles ne peuvent QUE renvoyer le HTML de leur page.",
  "windows": [
    "*"
  ],
  "webviews": [
    "shopr-*"
  ],
  "remote": {
    "urls": [
      "https://*"
    ]
  },
  "permissions": [
    "allow-shop-render-result"
  ]
}
